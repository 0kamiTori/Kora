# Copia este archivo como ".env.local" y completa los valores. NUNCA commitees claves reales.

# URL base de la API REST (FastAPI). Solo se usa cuando VITE_USE_MOCKS=false.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# URL del WebSocket autenticado de administración. Solo se usa cuando VITE_USE_MOCKS=false.
VITE_WS_URL=ws://localhost:8000/ws/admin

# Clave web de Google Maps. Vacía = se usa el mapa esquemático SVG (sin cartografía).
VITE_GOOGLE_MAPS_WEB_KEY=

# "true" (por defecto) usa el adaptador mock en memoria. "false" llama al backend real.
VITE_USE_MOCKS=true

# Canal de ayuda configurado (por ejemplo tel:+57... o una URL). Vacío = sin canal configurado.
# Abrirlo NO implica despacho automático de emergencias.
VITE_HELP_CHANNEL_URL=
