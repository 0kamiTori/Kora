  "components": {
    "schemas": {
      "PhoneInput": {
        "type": "object",
        "properties": {
          "country_calling_code": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{0,2}$",
            "description": "Código internacional con +. No identifica por sí solo un país."
          },
          "national_number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[0-9 ()-]+$",
            "description": "Admite presentación con espacios y guiones. Servidor interpreta plan de numeración y produce E.164; concatenar sin validar no basta."
          }
        },
        "required": [
          "country_calling_code",
          "national_number"
        ],
        "additionalProperties": false
      },
      "AccountConsent": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "const": true
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "accepted",
          "version"
        ],
        "additionalProperties": false
      },
      "AccountRegistrationV2": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 3,
            "maxLength": 254,
            "description": "Servidor quita espacios exteriores y usa minúsculas para unicidad, sin quitar puntos ni sufijos +."
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "writeOnly": true,
            "pattern": "^(?=[\\s\\S]*[A-ZÁÉÍÓÚÜÑ])(?=[\\s\\S]*[a-záéíóúüñ])(?=[\\s\\S]*[0-9])(?=[\\s\\S]*[^A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9\\s])[\\s\\S]+$",
            "description": "No recortar, normalizar ni truncar. Sin máximo individual acordado; cuerpo completo limitado a 16 KiB."
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=.*[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9])[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9 ]+$",
            "description": "NFC y espacios exteriores eliminados antes de validar. Espacios interiores conservados. No es único."
          },
          "birth_date": {
            "type": "string",
            "format": "date",
            "description": "Fecha civil YYYY-MM-DD, sin hora. Servidor valida que no sea futura y edad >=18 usando fecha America/Bogota."
          },
          "phone": {
            "$ref": "#/components/schemas/PhoneInput"
          },
          "requested_role": {
            "type": "string",
            "enum": [
              "passenger",
              "driver"
            ],
            "description": "Intención de onboarding; no concede rol driver ni presenta automáticamente solicitud documental."
          },
          "consent": {
            "$ref": "#/components/schemas/AccountConsent"
          }
        },
        "required": [
          "email",
          "password",
          "display_name",
          "birth_date",
          "phone",
          "requested_role",
          "consent"
        ],
        "additionalProperties": false
      },
      "ConsentText": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Texto plano aprobado para creación de cuenta; no autorización biométrica."
          }
        },
        "required": [
          "version",
          "text"
        ],
        "additionalProperties": false
      },
      "RegistrationPolicy": {
        "type": "object",
        "properties": {
          "policy_version": {
            "type": "string",
            "minLength": 1
          },
          "registration_enabled": {
            "type": "boolean"
          },
          "server_date": {
            "type": "string",
            "format": "date",
            "description": "Fecha informativa en Colombia; el POST vuelve a calcularla."
          },
          "minimum_age": {
            "type": "integer",
            "const": 18
          },
          "display_name_max_length": {
            "type": "integer",
            "const": 100
          },
          "password_rules": {
            "const": {
              "minimum_length": 12,
              "uppercase": true,
              "lowercase": true,
              "digit": true,
              "special_character": true
            }
          },
          "consent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConsentText"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "policy_version",
          "registration_enabled",
          "server_date",
          "minimum_age",
          "display_name_max_length",
          "password_rules",
          "consent"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "registration_enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "consent": {
                  "$ref": "#/components/schemas/ConsentText"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "registration_enabled": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "consent": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "AccountCreatedV2": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "roles": {
            "type": "array",
            "const": [
              "passenger"
            ]
          },
          "driver_approved": {
            "type": "boolean",
            "const": false
          },
          "driver_review_status": {
            "type": "string",
            "const": "not_submitted"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "consent_receipt": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "version",
              "recorded_at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "display_name",
          "roles",
          "driver_approved",
          "driver_review_status",
          "created_at",
          "consent_receipt"
        ],
        "additionalProperties": false
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "email",
              "password",
              "display_name",
              "birth_date",
              "phone",
              "phone.country_calling_code",
              "phone.national_number",
              "requested_role",
              "consent",
              "consent.accepted",
              "consent.version",
              "request"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "REQUIRED_FIELDS_MISSING",
              "CONSENT_REQUIRED",
              "CONTACT_INVALID",
              "PASSWORD_INVALID",
              "DISPLAY_NAME_INVALID",
              "BIRTH_DATE_INVALID",
              "AGE_RESTRICTED",
              "VALIDATION_ERROR",
              "CONTACT_NOT_AVAILABLE",
              "CONSENT_VERSION_CHANGED",
              "IDEMPOTENCY_CONFLICT",
              "REGISTRATION_IN_PROGRESS",
              "REQUEST_INVALID",
              "BODY_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "RATE_LIMITED",
              "REGISTRATION_DISABLED",
              "DATABASE_UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "RegistrationError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "REQUIRED_FIELDS_MISSING",
              "CONSENT_REQUIRED",
              "CONTACT_INVALID",
              "PASSWORD_INVALID",
              "DISPLAY_NAME_INVALID",
              "BIRTH_DATE_INVALID",
              "AGE_RESTRICTED",
              "VALIDATION_ERROR",
              "CONTACT_NOT_AVAILABLE",
              "CONSENT_VERSION_CHANGED",
              "IDEMPOTENCY_CONFLICT",
              "REGISTRATION_IN_PROGRESS",
              "REQUEST_INVALID",
              "BODY_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "RATE_LIMITED",
              "REGISTRATION_DISABLED",
              "DATABASE_UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          },
          "field_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "incident_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "retryable",
          "field_errors"
        ],
        "additionalProperties": false
      }
    }
  },
  "x-implementation-status": "contract-only-not-deployed",
