                },
                "description": "No almacenar respuestas del registro en cachés."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/RegistrationError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "REQUIRED_FIELDS_MISSING",
                            "CONSENT_REQUIRED",
                            "CONTACT_INVALID",
                            "PASSWORD_INVALID",
                            "DISPLAY_NAME_INVALID",
                            "BIRTH_DATE_INVALID",
                            "AGE_RESTRICTED",
                            "VALIDATION_ERROR"
                          ]
                        }
                      }
                    }
                  ]
