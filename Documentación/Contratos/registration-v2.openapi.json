{
  "openapi": "3.1.1",
  "info": {
    "title": "Köra Registro de cuentas v2",
    "version": "2.0.0-draft.1",
    "description": "Contrato de registro para implementación. No es API desplegada. Texto de consentimiento y responsable pendientes; registro real deshabilitado hasta aprobarlos."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v2",
      "description": "Desarrollo previsto; HTTPS obligatorio fuera de local"
    }
  ],
  "security": [],
  "paths": {
    "/registration-policy": {
      "get": {
        "operationId": "getRegistrationPolicyV2",
        "summary": "Consultar política y disponibilidad del registro",
        "security": [],
        "responses": {
          "200": {
            "description": "Política vigente. Sin consentimiento aprobado: registration_enabled=false y consent=null.",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador distinto por intento HTTP; no contiene datos personales.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                },
                "description": "No almacenar respuestas del registro en cachés."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationPolicy"
                }
              }
            }
          },
          "500": {
            "description": "Errores: INTERNAL_ERROR",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador distinto por intento HTTP; no contiene datos personales.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                },
                "description": "No almacenar respuestas del registro en cachés."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/RegistrationError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "INTERNAL_ERROR"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Errores: REGISTRATION_DISABLED, DATABASE_UNAVAILABLE",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador distinto por intento HTTP; no contiene datos personales.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                },
                "description": "No almacenar respuestas del registro en cachés."
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Segundos mínimos antes de reintentar; en 409 aplica solo a REGISTRATION_IN_PROGRESS."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/RegistrationError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "REGISTRATION_DISABLED",
                            "DATABASE_UNAVAILABLE"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/accounts": {
      "post": {
        "operationId": "registerAccountV2",
        "summary": "Crear cuenta de pasajera e intención opcional de solicitar habilitación",
        "security": [],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "UUID nuevo por envío lógico. Conservar clave y cuerpo durante reintentos; no guardar la contraseña en disco. TTL propuesto 24 h.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "UTF-8 application/json, máximo 16 KiB. No incluye documentos, fotos, tokens o permisos de administración.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountRegistrationV2"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta y consentimiento persistidos atómicamente. Reintento idéntico devuelve el mismo cuerpo.",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador distinto por intento HTTP; no contiene datos personales.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                },
                "description": "No almacenar respuestas del registro en cachés."
              },
              "Idempotency-Replayed": {
                "schema": {
                  "type": "boolean"
                },
                "description": "Indica reproducción de un éxito anterior; no altera el cuerpo."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountCreatedV2"
                }
              }
            }
          },
          "400": {
            "description": "Errores: REQUEST_INVALID",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador distinto por intento HTTP; no contiene datos personales.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                },
                "description": "No almacenar respuestas del registro en cachés."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/RegistrationError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "REQUEST_INVALID"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Errores: CONTACT_NOT_AVAILABLE, CONSENT_VERSION_CHANGED, IDEMPOTENCY_CONFLICT, REGISTRATION_IN_PROGRESS",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador distinto por intento HTTP; no contiene datos personales.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                },
                "description": "No almacenar respuestas del registro en cachés."
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Segundos mínimos antes de reintentar; en 409 aplica solo a REGISTRATION_IN_PROGRESS."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
