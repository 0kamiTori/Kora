                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                },
                "description": "No almacenar respuestas del registro en cachés."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/RegistrationError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "INTERNAL_ERROR"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Errores: REGISTRATION_DISABLED, DATABASE_UNAVAILABLE",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador distinto por intento HTTP; no contiene datos personales.",
