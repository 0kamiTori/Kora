                "description": "No almacenar respuestas del registro en cachés."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/RegistrationError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "BODY_TOO_LARGE"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Errores: UNSUPPORTED_MEDIA_TYPE",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador distinto por intento HTTP; no contiene datos personales.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                },
                "description": "No almacenar respuestas del registro en cachés."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/RegistrationError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "UNSUPPORTED_MEDIA_TYPE"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Errores: REQUIRED_FIELDS_MISSING, CONSENT_REQUIRED, CONTACT_INVALID, PASSWORD_INVALID, DISPLAY_NAME_INVALID, BIRTH_DATE_INVALID, AGE_RESTRICTED, VALIDATION_ERROR",
            "headers": {
