APP_ENV=local
DATABASE_URL=postgresql+psycopg://local_user:replace_me@127.0.0.1:55432/kora_test_api01
# Use a direct connection with migration privileges, not a client/APK credential.
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:replace_me@127.0.0.1:55432/kora_test_api01
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
# API01 only exposes /health/*, GET /api/v2/registration-policy and a closed POST gate.
# No environment flag enables real registration in this release.
REGISTRATION_MODE=disabled
# synthetic_test requires APP_ENV=test, localhost kora_test_* and .invalid emails.
# Only tests seed their approved test-* consent. Never seed it in Neon.
# REGISTRATION_CONSENT_VERSION=test-account-consent-v1
# REGISTRATION_HMAC_KEY=generate_an_independent_secret_of_at_least_32_bytes
INCIDENT_DIRECTORY=.local/incidents
