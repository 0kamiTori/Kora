# Copia este archivo como ".env" y completa los valores. NUNCA subas el .env a git.

# local | test. La verificación de identidad simulada solo existe con APP_ENV=test.
APP_ENV=local

# Conexión a PostgreSQL (13 o superior). Formato libpq, sin "+psycopg".
DATABASE_URL=postgresql://local_user:replace_me@127.0.0.1:5432/kora

# Secreto para firmar los tokens (mínimo 32 caracteres). Genera uno propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Orígenes del portal web autorizados (CORS con credenciales), separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# true cuando la API se sirve por HTTPS (marca la cookie de renovación como Secure).
COOKIE_SECURE=false

# Carpeta con los scripts SQL (001_esquema_inicial.sql, 002_sesiones.sql, ...).
SQL_DIR=./db

# Carpeta donde se guardan documentos y fotografías recibidos. Fuera de Git.
STORAGE_DIR=./storage

# pending: la verificación de identidad queda pendiente (no hay motor biométrico).
# simulated: doble de prueba; se ignora salvo con APP_ENV=test.
BIOMETRIC_MODE=pending

# Duración de los tokens.
ACCESS_TOKEN_MINUTES=15
ADMIN_SESSION_HOURS=12
MOBILE_SESSION_DAYS=30
